{
  "name": "ancestor-matrix-root",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ancestor-matrix-root",
      "workspaces": ["packages/*"],
      "dependencies": {
        "shared-lib": "*"
      }
    },
    "node_modules/shared-lib": {
      "resolved": "packages/shared-lib",
      "link": true
    },
    "node_modules/app": {
      "resolved": "packages/app",
      "link": true
    },
    "packages/shared-lib": {
      "name": "shared-lib"
    },
    "packages/app": {
      "name": "app"
    }
  }
}
